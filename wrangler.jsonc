// Cloudflare Pages project `checkandroll-app` (static, no build). Pages reads this file on every
// deploy, so the settings here replace the dashboard's for this project.
{
  "name": "checkandroll-app",
  "pages_build_output_dir": ".",
  "compatibility_date": "2026-11-01",
  // Who sent us visitors: daily totals only (LON-3645). The same database as mediaflowswift.com;
  // schema in longroadsoftware/mediaflowswift.com cloudflare/traffic-schema.sql.
  "d1_databases": [{ "binding": "TRAFFIC", "database_name": "lrs-traffic", "database_id": "535b9ac4-7a9a-4482-9af7-f4f3280d6755" }],
  "vars": {
    // Mike & Sheri's home internet, not counted as visitors (same list as lrs-downloads EXCLUDE_IPS).
    "EXCLUDE_IPS": "50.42.107.18/32,2001:1960:6800:88df::/64"
  }
}
